# macOS Finder metadata
.DS_Store

# Obsidian: keep vault settings in version control, ignore personal workspace state
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache/
**/.obsidian/.trash/

# Editor and IDE local state
.idea/
.vscode/
*.swp
*.swo
*~
.~lock.*#

# Native build directories and CMake-generated files
build/
out/
bin/
obj/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# PUNos system image: downloaded sources and generated trees
/System/download/
/System/linux-[0-9]*/
/System/linux-build/
/System/rootfs/

# Native compiler and linker outputs
*.o
*.obj
*.d
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.elf
*.map
*.img
*.iso

# Other language build outputs used by project tools
target/
.gradle/
*.class

# Runtime, test, and temporary files
*.log
*.tmp
*.bak
.cache/
tmp/
